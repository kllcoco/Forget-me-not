{
  "name": "dsh-forget-me-not",
  "version": "0.4.0",
  "description": "勿忘我：给任何 LLM 用的封存式记忆大脑——艾宾浩斯遗忘、联想召回、可塑性性格、自动总结，附 3D 莫比乌斯记忆星环与脑图。DeepSeek Harness 插件 / MCP / REST",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-forget-me-not": "bin/forget-me-not.js",
    "forget-me-not": "bin/forget-me-not.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "aurabot",
    "bin",
    "lib",
    "web",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-memory",
    "claude-code-plugin",
    "codex-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "ebbinghaus",
    "llm",
    "long-term-memory",
    "mcp",
    "memory",
    "persona-card",
    "three.js"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "start": "node bin/forget-me-not.js serve",
    "seed": "node bin/forget-me-not.js seed",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kllcoco/Forget-me-not.git"
  },
  "homepage": "https://github.com/kllcoco/Forget-me-not#readme",
  "bugs": {
    "url": "https://github.com/kllcoco/Forget-me-not/issues"
  },
  "author": "kllcoco"
}
